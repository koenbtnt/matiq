{
  "comment": "Display-name rules for GrappleMap names (plan §6.3 stage 5). Tokens are matched case-insensitively on word boundaries, longest first; the result is sentence-cased (first letter upper, the rest as written). Placeholders get '<from> to <to>' (A-32).",
  "tokens": {
    "w/": "with",
    "w/o": "without",
    "ctrl": "control",
    "rnc": "RNC",
    "vs": "vs.",
    "vs.": "vs.",
    "¼": "quarter",
    "¾": "three-quarter",
    "3/4": "three-quarter",
    "dlr": "DLR",
    "rdlr": "RDLR",
    "slx": "SLX",
    "kob": "knee on belly",
    "underh.": "underhook",
    "rev.": "reverse",
    "x-guard": "X-guard",
    "x guard": "X-guard",
    "single-x": "single-leg X",
    "s-mount": "S-mount",
    "2-on-1": "two-on-one",
    "japanese": "Japanese",
    "jean jacques": "Jean Jacques",
    "irish": "Irish",
    "boston": "Boston",
    "russian": "Russian",
    "thai": "Thai",
    "de la riva": "De la Riva",
    "darce": "D'arce",
    "o-soto-gari": "o-soto-gari",
    "imanari": "Imanari",
    "granby": "Granby",
    "aldo": "Aldo",
    "jiu-claw": "jiu-claw",
    "shitty": "weak"
  },
  "placeholders": ["^\\.\\.\\.", "^todo\\b", "^\\?$", "^$"],
  "positionPlaceholder": "Unnamed position {index}",
  "submissionPlaceholder": "Submission from {from}",
  "transitionPlaceholder": "{from} to {to}",
  "reverseSuffix": " (reverse)"
}
