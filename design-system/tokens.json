  },
  "semantic": {
    "tokens": [
      { "name": "focus-improving", "bg": "success", "text": "on-accent", "usage": "Progression: improving." },
      { "name": "focus-needs-work", "bg": "warning", "text": "text", "usage": "Progression: lacking / flagged needs work." }
