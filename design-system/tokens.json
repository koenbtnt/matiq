  "radius": {
    "tokens": [
      { "name": "radius-sm", "value": 6, "usage": "Chips." },
      { "name": "radius-md", "value": 12, "usage": "Cards, inputs." },
      { "name": "radius-lg", "value": 20, "usage": "Sheets." }
