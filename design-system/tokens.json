{
  "name": "matIQ",
  "version": 0,
  "_status": "starter",
  "_note": "STARTER PLACEHOLDER. Neutral values so the skeleton compiles and CI is green. Replaced by the designer agent's intake run from design-system/artifact/matiq-design.html (see design-system/README.md). No screen spec may be written against these values.",
  "color": {
    "themes": [{ "id": "light", "name": "Light" }, { "id": "dark", "name": "Dark" }],
    "tokens": [
      { "name": "bg", "value": { "light": "#f7f7f8", "dark": "#101114" }, "usage": "Screen background." },
      { "name": "surface", "value": { "light": "#ffffff", "dark": "#1a1c21" }, "usage": "Cards, sheets, inputs." },
      { "name": "surface-muted", "value": { "light": "#eceef1", "dark": "#262930" }, "usage": "Chips, selected rows, dividers' background." },
      { "name": "border", "value": { "light": "#dfe2e7", "dark": "#2e323a" }, "usage": "Card and input borders." },
      { "name": "text", "value": { "light": "#16181d", "dark": "#eef0f3" }, "usage": "Primary text." },
      { "name": "text-muted", "value": { "light": "#5b6270", "dark": "#9aa3b2" }, "usage": "Secondary text; meets 4.5:1 on surface." },
      { "name": "accent", "value": { "light": "#1f5fbf", "dark": "#7aa7ff" }, "usage": "Primary action, links, selected state." },
      { "name": "on-accent", "value": { "light": "#ffffff", "dark": "#0b1a33" }, "usage": "Text on accent." },
      { "name": "success", "value": { "light": "#2e7d32", "dark": "#6ccb70" }, "usage": "Improving / completed." },
      { "name": "warning", "value": { "light": "#b7791f", "dark": "#e9b44c" }, "usage": "Needs work / planned-but-not-trained." },
      { "name": "danger", "value": { "light": "#b42318", "dark": "#f0776b" }, "usage": "Destructive actions, errors." },
      { "name": "overlay", "value": { "light": "rgba(22, 24, 29, 0.45)", "dark": "rgba(0, 0, 0, 0.6)" }, "usage": "Scrim behind sheets." }
    ]
  },
  "type": {
    "fontFamily": { "regular": "System", "medium": "System", "semibold": "System", "bold": "System" },
    "families": { "sans": "System" },
    "groups": [
      {
        "name": "Headings",
        "family": "sans",
        "styles": [
          { "name": "heading-1", "fontSize": "24px", "lineHeight": 1.2, "fontWeight": 700, "usage": "Screen title." },
          { "name": "heading-2", "fontSize": "18px", "lineHeight": 1.25, "fontWeight": 600, "usage": "Section and card title." }
        ]
      },
      {
        "name": "Text",
        "family": "sans",
        "styles": [
          { "name": "body", "fontSize": "16px", "lineHeight": 1.45, "fontWeight": 400, "usage": "Default text, list rows." },
          { "name": "body-strong", "fontSize": "16px", "lineHeight": 1.45, "fontWeight": 600, "usage": "Button labels, emphasised rows." },
          { "name": "caption", "fontSize": "13px", "lineHeight": 1.4, "fontWeight": 500, "usage": "Labels, helper text." }
        ]
      },
      {
        "name": "Numbers",
        "family": "sans",
        "styles": [
          { "name": "number-lg", "fontSize": "28px", "lineHeight": 1.1, "fontWeight": 700, "usage": "Ratings and scores. Always tabular-nums." }
        ]
      }
    ]
  },
  "spacing": {
    "tokens": [
      { "name": "space-1", "value": 4, "usage": "Hairline gaps." },
      { "name": "space-2", "value": 8, "usage": "Inside chips and between related items." },
      { "name": "space-3", "value": 12, "usage": "Inside cards." },
      { "name": "space-4", "value": 16, "usage": "Screen gutter." },
      { "name": "space-6", "value": 24, "usage": "Between sections." },
      { "name": "space-8", "value": 32, "usage": "Above the primary action." }
